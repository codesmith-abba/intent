app $StorefrontCatalog {
    system {
        frontend {
            framework $react
        }
    }

    page $catalog $The product catalog groups products into a useful browsing experience {
        theme $light

        hero $catalogHero {
            headline $Find something useful
            subtitle $Browse the catalog by product type and discover what is available today.
            action $Browse catalog
        }

        section $filters $Give customers a small set of useful filtering controls {
            headline $Filter products
            subtitle $Keep browsing focused without overwhelming the customer.
            action $Apply filters
        }

        section $productGrid $Present the available products in a clear grid {
            headline $Product catalog
            subtitle $Compare products before opening a product detail page.
        }
    }

    target $web
}
