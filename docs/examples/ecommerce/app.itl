// ======================================================
// Intent Language (ITL)
// Example: E-Commerce Application
// ======================================================

app $SMarket {

    intent $(
        Build a modern AI-assisted fashion marketplace where
        customers can discover products, communicate with sellers,
        place orders securely, and track deliveries.

        The application should be responsive, accessible,
        scalable, and optimized for mobile-first experiences.
    )

    import $all

    system {

        frontend {

            framework $react

        }

        backend {

            framework $django

            api $rest

        }

        database {

            engine $postgres

        }

        cache {

            engine $redis

        }

        storage {

            provider $local

        }

    }

    target $web
}